{
  "openapi": "3.0.0",
  "info": {
    "title": "Trial Internal API",
    "version": "1.0.0",
    "description": "API for managing trial results and reporting."
  },
  "servers": [
    {
      "url": "https://initiatorurl/v1",
      "description": "Production server"
    },
    {
      "url": "https://initiatorurl-test/v1",
      "description": "Test server"
    }
  ],
  "paths": {
    "/trials": {
      "get": {
        "summary": "Get all the 'trial' resources in the collaborator context",
        "operationId": "getTrials",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/schemas/GetTrialsResponse"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "summary": "Create a new trial resource in the Initiator context",
        "operationId": "createTrial",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Trial created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreationResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/trials/{trialId}": {
      "delete": {
        "summary": "Delete a trial resource in the Initiator context",
        "operationId": "deleteTrial",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "trialId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Trial deleted"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "description": "Trial not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/trials/{trialId}/results/{collaboratorId}": {
      "put": {
        "summary": "Create or update a sub-resource result of a specific collaborator for a given trial",
        "operationId": "createResult",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "trialId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "collaboratorId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Single collaborator result for the trial",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResultRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created or updated the trial result"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "description": "Trial not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/trials/{trialId}/results": {
      "get": {
        "summary": "Return all results for a specific trial",
        "operationId": "getResults",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "trialId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successfully retrieved evaluation of trial results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResultResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "description": "Trial not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/trials/{trialId}/report": {
      "put": {
        "summary": "Create a report resource for a specific trial within the Initiator context",
        "operationId": "createReport",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "trialId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "Report details for the trial",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The report was successfully created"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "description": "Trial not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "UnauthorizedError": {
        "description": "Access token is missing or invalid"
      }
    },
    "schemas": {
      "CreationRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "target_type": {
            "type": "string",
            "enum": [
              "human",
              "sample",
              "animal"
            ]
          },
          "duration": {
            "type": "integer",
            "description": "Duration in days"
          },
          "min_num_samples": {
            "type": "integer"
          },
          "remuneration": {
            "type": "number",
            "format": "float"
          }
        },
        "required": [
          "title",
          "description",
          "category",
          "target_type",
          "duration",
          "min_num_samples",
          "remuneration"
        ]
      },
      "CreationResponse": {
        "type": "object",
        "properties": {
          "trialId": {
            "type": "string",
            "description": "Unique ID for the trial, also unique among Collaborators"
          }
        },
        "required": [
          "trialId"
        ]
      },
      "ResultRequest": {
        "type": "object",
        "properties": {
          "num_samples": {
            "type": "integer"
          },
          "num_success": {
            "type": "integer"
          }
        },
        "required": [
          "num_samples",
          "num_success"
        ]
      },
      "ReportRequest": {
        "type": "object",
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "samples_total": { "type": "integer" },
              "success_average": { "type": "number", "format": "float" }
            },
            "required": ["samples_total", "success_average"]
          }
        },
        "required": ["result"]
      },
      "ResultResponse": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ResultRequest"
            }
          }
        },
        "required": ["results"]
      },
      "GetTrialsResponse": {
        "type": "array",
        "items": {
          "allOf": [
            { "$ref": "#/components/schemas/CreationRequest" },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": ["WAITING_FOR_START", "STARTED", "ENDED"]
                }
              },
              "required": ["status"]
            }
          ]
        }
      }
    }
  }
}