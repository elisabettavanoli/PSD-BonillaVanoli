{
  "openapi": "3.0.0",
  "info": {
    "title": "Collaborator Trial API",
    "version": "1.0.0",
    "description": "API set for collaborators involved clinical trials."
  },
  "servers": [
    {
      "url": "https://collaboratorurl/v1",
      "description": "Production server"
    },
    {
      "url": "https://collaboratorurl-test/v1",
      "description": "Test server"
    }
  ],
  "paths": {
    "/trials": {
      "get": {
        "summary": "Get all the 'trial' resources in the collaborator context",
        "operationId": "getTrials",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/schemas/GetTrialsResponse"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "summary": "Create the 'trial' resource in the collaborator context, which will initialize the trial status with 'WAITING_FOR_START' ",
        "operationId": "createTrial",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Trial created"
          },
          "400": {
            "description": "Trial with trialId already present"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/trials/{trialId}": {
      "delete": {
        "summary": "Delete the trial resource in the collaborator context",
        "operationId": "deleteTrial",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "trialId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Trial deleted"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "description": "Trial not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "patch": {
        "summary": "Update the status (started, ended, ...) of the trial resource in the collaborator context",
        "operationId": "updateTrialStatus",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "trialId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateStatusRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Trial status updated"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "description": "Trial not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/trials/{trialId}/reminders": {
      "post": {
        "summary": "Create a sub-resource reminder in the collaborator context",
        "operationId": "trialReminder",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "trialId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReminderRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reminder created"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "description": "Trial not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/trials/{trialId}/report": {
      "put": {
        "summary": "Create or update a single sub-resource report in the collaborator context",
        "operationId": "trialReport",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "trialId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Report created or updated"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          },
          "404": {
            "description": "Trial not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "UnauthorizedError": {
        "description": "Access token is missing or invalid"
      }
    },
    "schemas": {
      "CreationRequest": {
        "type": "object",
        "properties": {
          "trialId": {
            "type": "string",
            "description": "This id is generated by the Initiator and it's unique for all collaborators"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "target_type": {
            "type": "string",
            "enum": [
              "human",
              "sample",
              "animal"
            ]
          },
          "duration": {
            "type": "integer",
            "description": "Duration in days"
          },
          "min_num_samples": {
            "type": "integer"
          },
          "remuneration": {
            "type": "number",
            "format": "float"
          }
        },
        "required": [
          "trialId",
          "title",
          "description",
          "category",
          "target_type",
          "duration",
          "min_num_samples",
          "remuneration"
        ]
      },
      "ParticipationResponse": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean",
            "description": "Indicates if the participation request was accepted"
          },
          "reason": {
            "type": "string",
            "description": "If not accepted, provides a reason for the rejection"
          }
        },
        "required": [
          "accepted"
        ]
      },
      "UpdateStatusRequest": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "STARTED",
              "ENDED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "ReminderRequest": {
        "type": "object",
        "properties": {
          "endAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "endAt"
        ]
      },
      "ReportRequest": {
        "type": "object",
        "properties": {
          "result": {
            "type": "object",
            "properties": {
              "samples_total": {
                "type": "integer"
              },
              "success_average": {
                "type": "number",
                "format": "float"
              },
              "num_participants": { "type": "integer" },
              "trial_conclusions": { "type": "string" }
            },
            "required": [
              "samples_total",
              "success_average"
            ]
          }
        },
        "required": [
          "result"
        ]
      },
      "GetTrialsResponse": {
        "type": "array",
        "items": {
          "allOf": [
            { "$ref": "#/components/schemas/CreationRequest" },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": ["WAITING_FOR_START", "STARTED", "ENDED"]
                }
              },
              "required": ["status"]
            }
          ]
        }
      }
    }
  }
}