{
  "correlationSets": [
    {
      "apiDescription": "Async Api for accept/deny participation",
      "name": "answers",
      "correlationKey": "<trial_id>_<collaborator_id>",
      "correlationSet": {
        "answer": ["yes", "no"]
      }
    },
    {
      "apiDescription": "Async Api for share own results",
      "name": "results",
      "correlationKey": "<trial_id>_<collaborator_id>",
      "correlationSet": {
        "num_samples": "number",
        "num_success": "number"
      }
    }
  ]
}