{
  "openapi": "3.0.0",
  "info": {
    "title": "Trial Internal API",
    "version": "1.0.0",
    "description": "API for managing trial results and reporting."
  },
  "paths": {
    "/trial/evaluateResults": {
      "get": {
        "summary": "Evaluate the results of a trial",
        "operationId": "evaluateResults",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "description": "Data for evaluating trial results",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CollaboratorEvaluationInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully evaluated the trial results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/trial/createReport": {
      "get": {
        "summary": "Create a report based on trial results",
        "operationId": "createReport",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "description": "Data for creating a trial report",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CollaboratorEvaluationInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created the trial report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad request"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "responses": {
      "UnauthorizedError": {
        "description": "Access token is missing or invalid"
      }
    },
    "schemas": {
      "CollaboratorData": {
        "type": "object",
        "properties": {
          "id_collaborator": {
            "type": "string"
          },
          "num_samples": {
            "type": "integer"
          },
          "num_success": {
            "type": "integer"
          }
        },
        "required": ["id_collaborator", "num_samples", "num_success"]
      },
      "CollaboratorEvaluationInput": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CollaboratorData"
            }
          }
        },
        "required": ["data"]
      },
      "EvaluationResult": {
        "type": "object",
        "properties": {
          "satisfied": {
            "type": "boolean"
          }
        },
        "required": ["satisfied"]
      },
      "ReportResult": {
        "type": "object",
        "properties": {
          "results": {
            "type": "object",
            "properties": {
              "sample_total": {
                "type": "integer"
              },
              "success_average": {
                "type": "number",
                "format": "float"
              }
            },
            "required": ["sample_total", "success_average"]
          }
        },
        "required": ["results"]
      }
    }
  }
}