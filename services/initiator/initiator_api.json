{
  "openapi": "3.0.0",
  "info": {
    "title": "Trial Internal API",
    "version": "1.0.0",
    "description": "API for managing trial results and reporting."
  },
  "servers": [
    {
      "url": "https://initiatorurl/v1",
      "description": "Production server"
    },
    {
      "url": "https://initiatorurl-test/v1",
      "description": "Test server"
    }
  ],
  "paths": {
    "/trial/evaluateResults": {
      "get": {
        "summary": "Evaluate the results of a trial",
        "operationId": "evaluateResults",
        "security": [{
          "bearerAuth": []
        }],
        "requestBody": {
          "description": "Data for evaluating trial results",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully evaluated the trial results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EvaluationResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/trial/createReport": {
      "get": {
        "summary": "Create a report based on trial results",
        "operationId": "createReport",
        "security": [{
          "bearerAuth": []
        }],
        "requestBody": {
          "description": "Data for creating a trial report",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EvaluationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successfully created the trial report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportResponse"
                }
              }
            }
          },
          "404": {
            "description": "Invalid input"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    },
    "/trial/{id}": {
      "post": {
        "summary": "Store trial in database",
        "operationId": "storeTrial",
        "security": [{
          "bearerAuth": []
        }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Unique identifier for the trial",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrialSubmission"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Trial data successfully processed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessMessage"
                }
              }
            }
          },
          "404": {
            "description": "Invalid input"
          },
          "401": {
            "$ref": "#/components/responses/UnauthorizedError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
        "bearerAuth": {
          "type": "http",
          "scheme": "bearer",
          "bearerFormat": "JWT"
        }
    },
    "responses": {
      "UnauthorizedError": {
        "description": "Access token is missing or invalid"
      }
    },
    "schemas": {
      "CollaboratorResult": {
        "type": "object",
        "properties": {
          "id_collaborator": {
            "type": "string"
          },
          "num_samples": {
            "type": "integer"
          },
          "num_success": {
            "type": "integer"
          }
        },
        "required": ["id_collaborator", "num_samples", "num_success"]
      },
      "EvaluationRequest": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CollaboratorResult"
            }
          }
        },
        "required": ["data"]
      },
      "EvaluationResponse": {
        "type": "object",
        "properties": {
          "satisfied": {
            "type": "boolean"
          }
        },
        "required": ["satisfied"]
      },
      "ReportResponse": {
        "type": "object",
        "properties": {
          "results": {
            "type": "object",
            "properties": {
              "sample_total": {
                "type": "integer"
              },
              "success_average": {
                "type": "number",
                "format": "float"
              }
            },
            "required": ["sample_total", "success_average"]
          }
        },
        "required": ["results"]
      },
      "Trial": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "targetType": {
            "type": "string"
          },
          "minNumSamples": {
            "type": "integer"
          },
          "remuneration": {
            "type": "number",
            "format": "float"
          }
        },
        "required": ["title", "description", "category", "targetType", "minNumSamples", "remuneration"]
      },
      "TrialResult": {
        "type": "object",
        "properties": {
          "num_samples": {
            "type": "integer"
          },
          "num_success": {
            "type": "integer"
          }
        },
        "required": ["num_samples", "num_success"]
      },
      "TrialSubmission": {
        "type": "object",
        "properties": {
          "trial": {
            "$ref": "#/components/schemas/Trial"
          },
          "collaborators": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "result": {
            "$ref": "#/components/schemas/TrialResult"
          }
        },
        "required": ["trial", "collaborators", "result"]
      },
      "SuccessMessage": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        }
      }
    }
  }
}
